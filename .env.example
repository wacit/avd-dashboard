# ---- Required ----
# The Log Analytics *workspace ID* (a GUID) that your AVD Insights workbook
# queries. Find it in: Azure Portal > Log Analytics workspace > Overview >
# "Workspace ID".
AVD_WORKSPACE_ID=00000000-0000-0000-0000-000000000000

# ---- Auth ----
# Authentication uses azure-identity DefaultAzureCredential. Easiest local
# option: run `az login` with an account that has the "Log Analytics Reader"
# role on the workspace, then leave the variables below blank.
#
# Or use a service principal (app registration) with Log Analytics Reader:
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

# ---- Optional server settings ----
AVD_APP_HOST=127.0.0.1
AVD_APP_PORT=8000
AVD_DEFAULT_RANGE=24h

# ---- DEX agent ingest ----
# Shared secret the session-host DEX agent sends in the X-Agent-Key header.
# Ingest stays disabled (HTTP 503) until this is set. Generate one with:
#   [guid]::NewGuid().ToString('N')
# AVD_AGENT_KEY=
# SQLite file for agent telemetry and days of history to keep.
# AVD_AGENT_DB=dex-agent.db
# AVD_AGENT_RETENTION_DAYS=14

# ---- Optional alert thresholds ----
# success_rate: higher is better (warn = OK floor, bad = WARN floor).
# others: higher is worse (>= warn -> WARN, >= bad -> BAD).
# AVD_THR_SUCCESS_WARN=98
# AVD_THR_SUCCESS_BAD=90
# AVD_THR_ERRORS_WARN=1
# AVD_THR_ERRORS_BAD=50
# AVD_THR_RTT_WARN=80
# AVD_THR_RTT_BAD=150
# AVD_THR_PROFILE_WARN=15
# AVD_THR_PROFILE_BAD=30
